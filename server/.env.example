# CONFIGURACIÓN DEL SERVIDOR
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# CONFIGURACIÓN MICROSOFT SQL SERVER
# Use un login con permisos solo sobre MythicShelfDB (ver database/configurar_credenciales.sql), no 'sa'
DB_USER=mythic_user
DB_PASSWORD=
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=MythicShelfDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# SEGURIDAD Y JWT
# Obligatorio, mínimo 32 caracteres aleatorios. Genérelo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# NOTIFICACIONES SMTP (NODEMAILER)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mythic_service@ethereal.email
SMTP_PASS=ethereal_generated_pass
SMTP_FROM="Mythic Shelf Support <noreply@mythicshelf.com>"

# CATÁLOGO DE IMÁGENES (npm run seed:catalog)
# Wikimedia exige un User-Agent identificable con un contacto real
WIKIMEDIA_USER_AGENT="MythicShelf/1.0 (tu-correo@dominio.com)"
# Opcional: clave de Pokémon TCG API (aumenta el límite de peticiones)
POKEMONTCG_API_KEY=
# Vendedor que publicará los productos sembrados
SEED_SELLER_EMAIL=seller@mythicshelf.com
